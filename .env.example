# Compose project settings. Use a separate .env in each branch checkout.
POSTGRES_DB=auction
POSTGRES_USER=auction
POSTGRES_PASSWORD=change-me

# Stripe test-mode credentials for local development; use branch-specific values in production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=re_replace_me
EMAIL_FROM=onboarding@resend.dev

# Local Compose defaults. For production, set FRONTEND_URL to that deployment's HTTPS URL
# and leave VITE_SOCKET_URL empty so the browser uses the same-origin Caddy proxy.
FRONTEND_URL=http://localhost:5173
VITE_SOCKET_URL=http://localhost:3000

# Production aliases on the existing external Docker "edge" network.
BACKEND_ALIAS=auction-main-api
FRONTEND_ALIAS=auction-main-web
